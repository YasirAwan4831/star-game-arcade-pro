
# .gitignore for a Unity game project

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
UserSettings/
MemoryCaptures/
sysinfo.txt

# Asset store tools / exports
*.unitypackage
ExportedObj/

# Visual Studio / Rider / VSCode
.vscode/
.vs/
.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.userosscache
*.pidb
*.booproj

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
*.apk
*.aab
*.obb

# Logs
*.log
